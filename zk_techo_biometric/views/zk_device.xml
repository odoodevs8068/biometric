<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_zk_device_form_view" model="ir.ui.view">
        <field name="name">view_zk_device_form_view</field>
        <field name="model">zk_device</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="buttons">
                        <button icon="fa-sun-o" name="test_connection_device" type="object" string="Connect Device"
                                class="oe_stat_button" help="Test connection to the attendance device"
                        />
                        <button icon="fa-sun-o" name="disable_device" type="object" string="DisConnect Device"
                                class="oe_stat_button" help="DisConnect Device"
                        />
                        <button icon="fa-download" name="button_open_print_wizard" type="object"
                                string="Download Attendance" class="oe_stat_button"
                                help="Download Attendance from device"/>
                    </div>
                    <widget name="web_ribbon" title="Connected" bg_color="bg-success"  attrs="{'invisible' : [('device_state' , '=', False)]}" />
                    <widget name="web_ribbon" title="Disconnected" bg_color="bg-danger"  attrs="{'invisible' : [('device_state' , '=', True)]}" />
                    <div class="oe_title">
                        <lable for="company_id"/>
                        <group>
                            <group>
                                <h1>
                                    <field name="branch_area"/>
                                </h1>
                            </group>
                        </group>
                        <h5>
                            <field name="company_id"/>
                        </h5>
                    </div>
                    <group col="3">
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="device_state" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page  name="Device_Configuration"
                              string="Device Configuration">
                            <group col="3">
                                <group>
                                    <field name="ipaddress" required="1" string="Machine IP"/>
                                    <field name="port" required="1" string="Machine Port"/>
                                </group>
                            </group>
                        </page>
                        <page name="Device_Information" string="Device Information">
                            <group col="3">
                                <group>
                                    <field name="name"/>
                                    <field name="device_id"/>
                                    <field name="serial"/>
                                    <field name="version"/>
                                </group>
                                <group>
                                    <field name="fp_version"/>
                                    <field name="face_version"/>
                                    <field name="device_state"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_zk_device_tree_view" model="ir.ui.view">
        <field name="name">view_zk_device_tree_view</field>
        <field name="model">zk_device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" optional="show"/>
                <field name="name"/>
                <field name="user_id" optional="show"/>
                <field name="device_state" optional="show"/>

            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_zk_device">
        <field name="name">ZK Device</field>
        <field name="res_model">zk_device</field>
        <field name="view_mode">tree,form</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="zk_techo_biometric.view_zk_device_tree_view"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Zk Device Info
            </p>
        </field>
    </record>


<!--    DEVICE AREA-->
    <record id="view_zk_device_area_tree_view" model="ir.ui.view">
        <field name="name">view_zk_device_area_tree_view</field>
        <field name="model">zk_device_area</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="area_id" attrs="{'invisible' : [('area_id' , '=', 0)]}"/>
                <field name="area_code"/>
                <field name="area_name" />
                <button name="create_area" type="object" class="btn btn-primary" string="Create"
                        icon="fa-plus"
                        attrs="{'invisible' : [('area_id' , '!=', 0)]}"/>
                <button name="update_area" type="object" string="Edit" class="btn btn-secondary"
                        icon="fa-edit"
                        attrs="{'invisible' : [('area_id' , '=', 0)]}"/>
                <button name="delete_area" icon="fa-trash-o" type="object" class="btn btn-secondary "
                        string="Delete"
                        attrs="{'invisible' : [('area_id' , '=', 0)]}"/>

            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_zk_area">
        <field name="name">Area</field>
        <field name="res_model">zk_device_area</field>
        <field name="view_mode">tree</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_id" ref="zk_techo_biometric.view_zk_device_area_tree_view"/>
    </record>

    <record id="hr_attendance_view_calendar" model="ir.ui.view">
        <field name="name">hr.attendance.calendar</field>
        <field name="model">hr.attendance</field>
        <field name="arch" type="xml">
            <calendar date_start="check_in" color="employee_id" mode="month" quick_add="False">
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
            </calendar>
        </field>
    </record>

    <record id="hr_attendance.hr_attendance_action" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,calendar</field>
    </record>

    <menuitem name="Biometric Device"
              id="hr_biometric_device_configuration_menu"
              parent="hr_attendance.menu_hr_attendance_settings"
              action="action_zk_device"
              groups="hr_attendance.group_hr_attendance_manager"
              sequence="2"/>

    <menuitem name="Area"
              id="hr_biometric_zk_area_configuration_menu"
              parent="hr_attendance.menu_hr_attendance_settings"
              action="action_zk_area"
              groups="hr_attendance.group_hr_attendance_manager"
              sequence="3"/>

    <menuitem name="Settings" id="menu_hr_attendance_settings"
              groups="hr_attendance.group_hr_attendance_manager"
              parent="hr_attendance.menu_hr_attendance_settings"
              action="hr_attendance.action_hr_attendance_settings"
              sequence="20"/>

    <menuitem id="hr_attendance.menu_hr_attendance_view_attendances"
              name="Attendances"
              parent="hr_attendance.menu_hr_attendance_root"
              sequence="10" groups="hr_attendance.group_hr_attendance_user" action="hr_attendance.hr_attendance_action"/>


</odoo>