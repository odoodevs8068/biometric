<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_print_wizard_form_zk" model="ir.ui.view">
        <field name="name">view_print_wizard_form_zk</field>
        <field name="model">zk_print_wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="emp_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                     <button name="button_print_report" class="oe_stat_button" icon="fa-download" type="object" />
                     <button string="CANCEL" class="button_cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>